<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="16dp"
    tools:context=".activities.ThankYouActivity">

    <ImageView
        tools:src="@drawable/ic_success"
        android:layout_width="98dp"

        android:layout_height="125dp"/>


    <TextView
        android:id="@+id/tvThankYouMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="Cảm ơn bạn đã đặt hàng!"
        android:textSize="24sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgThankYouProduct"
        android:layout_width="183dp"
        android:layout_height="184dp"
        android:layout_marginBottom="16dp"
        android:scaleType="centerCrop"
        tools:src="@drawable/product1" />

    <TextView
        android:id="@+id/tvOrderDetails"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Thông tin đơn hàng:"
        android:textSize="18sp"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvOrderInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textSize="16sp"
        tools:text="Sản phẩm: Cafe Sữa\nSố lượng: 1\nTổng tiền: 50.000đ"/>

    <Button
        android:id="@+id/btnBackToHome"
        android:layout_width="149dp"
        android:layout_height="82dp"
        android:backgroundTint="#795548"

        android:layout_marginTop="24dp"
        android:text="Về trang chủ"
        android:textColorLink="#FF5722" />

</LinearLayout>