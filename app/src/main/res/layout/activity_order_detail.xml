<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB"
    tools:context=".activities.OrderDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Thanh tiêu đề -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:padding="12dp"
            android:background="@android:color/white"
            android:elevation="4dp"
            android:layout_marginTop="4dp"
            android:clipToOutline="true">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_centerVertical="true"
                android:src="@drawable/back_ic"
                android:contentDescription="Back"
                android:padding="4dp" />

            <TextView
                android:id="@+id/tvOrderDetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Chi tiết đơn hàng"
                android:textSize="22sp"
                android:textColor="#222222"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Thông tin giao hàng -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp"
            android:clipToOutline="true"
            android:layout_marginTop="8dp"
            android:backgroundTint="#FFFFFFFF">

            <TextView
                android:id="@+id/tvAddressLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Địa chỉ giao hàng:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#333" />

            <TextView
                android:id="@+id/tvAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Số 12 Nguyễn Văn Bảo, Gò Vấp, TP.HCM"
                android:textSize="16sp"
                android:textColor="#555" />

            <TextView
                android:id="@+id/tvPaymentMethodLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Phương thức thanh toán:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#333" />

            <TextView
                android:id="@+id/tvPaymentMethod"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Thanh toán khi nhận hàng (COD)"
                android:textSize="16sp"
                android:textColor="#555" />
        </LinearLayout>

        <!-- Danh sách sản phẩm -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@android:color/white"
            android:padding="16dp"
            android:elevation="2dp"
            android:layout_marginBottom="12dp"
            android:clipToOutline="true"
            android:backgroundTint="#FFFFFFFF">

            <TextView
                android:id="@+id/tvProductsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sản phẩm đã đặt:"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#333" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvOrderItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <!-- Check box và nút hành động -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <CheckBox
                android:id="@+id/cbOrderCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#FFF5F5F5"
                android:padding="8dp"
                android:checked="false"
                android:text="Đã nhận được hàng"
                android:textColor="#333"
                android:textSize="16sp" />

            <Button

                android:id="@+id/btnReceiveOrder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:paddingHorizontal="24dp"
                android:paddingVertical="10dp"
                android:text="Nhận đơn hàng"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#795548"
                android:elevation="2dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
