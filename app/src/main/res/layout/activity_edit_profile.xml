<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/brand_background"
    tools:context=".activities.EditProfileActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Cập Nhật Thông Tin"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/brand_brown_dark"
        android:layout_marginBottom="32dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputFullName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Họ và tên"
                app:hintTextColor="@color/brand_brown_medium"
                app:boxStrokeColor="@color/brand_brown_medium"
                android:textColorHint="@color/brand_brown_light"
                app:boxBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEditFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapWords"
                    android:textColor="@color/brand_brown_dark"/>
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Số điện thoại"
                app:hintTextColor="@color/brand_brown_medium"
                app:boxStrokeColor="@color/brand_brown_medium"
                android:textColorHint="@color/brand_brown_light"
                app:boxBackgroundColor="@color/white"
                android:layout_marginBottom="24dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/editTextEditPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="phone"
                    android:textColor="@color/brand_brown_dark"/>
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Địa chỉ"
                android:textColor="@color/brand_brown_dark"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutSpnProvince"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Tỉnh/Thành phố"
                app:boxBackgroundColor="@color/white"
                app:endIconMode="dropdown_menu"
                android:layout_marginBottom="16dp">
                <AutoCompleteTextView
                    android:id="@+id/spnProvince"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:contentDescription="Tỉnh/Thành phố"  />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutSpnDistrict"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Quận/Huyện"
                app:boxBackgroundColor="@color/white"
                app:endIconMode="dropdown_menu"
                android:layout_marginBottom="16dp">
                <AutoCompleteTextView
                    android:id="@+id/spnDistrict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:contentDescription="Quận/Huyện" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutSpnWard"
                style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Phường/Xã"
                app:boxBackgroundColor="@color/white"
                app:endIconMode="dropdown_menu"
                android:layout_marginBottom="16dp">
                <AutoCompleteTextView
                    android:id="@+id/spnWard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:contentDescription="Phường/Xã" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutInputAddressLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Địa chỉ cụ thể (Số nhà, tên đường...)"
                app:hintTextColor="@color/brand_brown_medium"
                app:boxStrokeColor="@color/brand_brown_medium"
                android:textColorHint="@color/brand_brown_light"
                app:boxBackgroundColor="@color/white"
                android:layout_marginBottom="16dp">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/edtDetailAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:textColor="@color/brand_brown_dark"/>
            </com.google.android.material.textfield.TextInputLayout>

            <CheckBox
                android:id="@+id/cbDefaultAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đặt làm địa chỉ mặc định"
                android:checked="true"
                android:enabled="false"
                android:visibility="gone"/>

        </LinearLayout>
    </ScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/buttonSaveChanges"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Lưu Thay Đổi"
        app:cornerRadius="8dp"
        android:paddingVertical="12dp"
        android:backgroundTint="@color/brand_brown_medium"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginTop="16dp"/>

</LinearLayout>